<?xml version="1.0" encoding="utf-8"?>
<MotionScene
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <Transition
        app:constraintSetEnd="@id/end"
        app:constraintSetStart="@id/start"
        />

    <!-- The actual start state of the transition -->

    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@id/options_rv"
            android:layout_height="200dp"
            app:layout_constraintTop_toBottomOf="@id/swipe_indicator"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/margin_top_options_rv"
            />
        <Constraint
            android:id="@id/bottom_panel"
            app:layout_constraintTop_toBottomOf="@id/options_rv"
            android:layout_width="match_parent"
            />
    </ConstraintSet>

    <!-- The actual end state of the transition -->

    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@id/options_rv"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_panel"
            app:layout_constraintTop_toBottomOf="@id/swipe_indicator"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/margin_top_options_rv"
            />
        <Constraint
            android:id="@id/bottom_panel"
            android:layout_width="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
    </ConstraintSet>
</MotionScene>