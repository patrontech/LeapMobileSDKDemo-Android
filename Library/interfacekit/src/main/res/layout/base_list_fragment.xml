<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <com.greencopper.interfacekit.ui.views.navigationcontrols.KibaToolbar
        android:id="@+id/baseListToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        />

    <View
        android:id="@+id/baseListFilteringBarBorderTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/baseListToolbar"
        />

    <com.greencopper.interfacekit.filtering.filteringbar.ui.FilteringBar
        android:id="@+id/baseListFilteringBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/baseListFilteringBarBorderTop"
        />

    <View
        android:id="@+id/baseListFilteringBarBorderBottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/baseListFilteringBar"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/baseListRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/baseListFilteringBarBorderBottom"
        />

    <LinearLayout
        android:id="@+id/baseListEmptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/baseListEmptyViewImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/baseListEmptyViewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:gravity="center"
            android:paddingTop="38dp"
            android:paddingBottom="16dp"
            tools:text="No Favorites"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/baseListEmptyViewSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:gravity="center"
            tools:text="Your favorites will show up here!"
            />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
