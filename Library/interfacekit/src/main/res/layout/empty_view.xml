<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="?attr/actionBarSize"
    >

    <com.greencopper.interfacekit.widgets.ui.widgetcollection.integration.WidgetCollectionView
        android:id="@+id/widgetCollectionView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivEmptySchedule"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="68dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toTopOf="@id/spaceBelowIvEmptySchedule"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.4"
        app:layout_constraintTop_toBottomOf="@id/widgetCollectionView"
        app:layout_constraintVertical_bias="0.45"
        app:layout_constraintVertical_chainStyle="packed"
        tools:src="@tools:sample/avatars"
        />

    <View
        android:id="@+id/spaceBelowIvEmptySchedule"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/tvEmptyScheduleTitle"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.05"
        app:layout_constraintTop_toBottomOf="@+id/ivEmptySchedule"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvEmptyScheduleTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/tvEmptyScheduleSubtitle"
        app:layout_constraintTop_toBottomOf="@id/spaceBelowIvEmptySchedule"
        tools:text="No Schedule Created"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvEmptyScheduleSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tvEmptyScheduleTitle"
        app:layout_constraintStart_toStartOf="@id/tvEmptyScheduleTitle"
        app:layout_constraintTop_toBottomOf="@id/tvEmptyScheduleTitle"
        tools:text="You can add specific activities here!"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
