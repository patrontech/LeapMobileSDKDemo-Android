<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navigationFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/crutch"
        />

    <!--
        This is a dummy view to make Compose bottomsheet resizable.
        See https://leapeventtech.slack.com/archives/C01LXMLB8F7/p1755716634388289 for more info
    -->
    <View
        android:id="@+id/crutch"
        android:layout_width="match_parent"
        android:layout_height="0.1dp"
        android:layout_alignParentBottom="true"
        />
</RelativeLayout>

