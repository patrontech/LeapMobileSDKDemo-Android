<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/CustomBottomSheetRounded"
    android:orientation="vertical"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <ImageView
        android:id="@+id/swipe_indicator"
        android:layout_width="@dimen/width_swipe_indicator"
        android:layout_height="@dimen/height_swipe_indicator"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/margin_top_swipe_indicator"
        android:layout_marginBottom="10dp"
        android:src="@drawable/draggable_cursor_shape" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/bottom_sheet_fragment_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>
