<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.greencopper.interfacekit.fullscreenmedia.ui.TouchImageView
        android:id="@+id/image_full_screen"
        android:accessibilityTraversalAfter="@id/navigate_close_button"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.greencopper.interfacekit.ui.views.navigationcontrols.NavigateBackButton
        android:id="@+id/navigate_back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone"/>

    <com.greencopper.interfacekit.ui.views.navigationcontrols.NavigateCloseButton
        android:id="@+id/navigate_close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityTraversalAfter="@id/navigate_back_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>
