<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/horizontal_margin"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:importantForAccessibility="no"
            >

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:visibility="visible"
                tools:src="@tools:sample/backgrounds/scenic"
                />

            <com.google.android.material.textview.MaterialTextView
                style="@style/CountdownWidgetIndicator"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:gravity="start"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="CREAMFIELD NORTH"
                tools:textColor="#fff"
                />

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/divider_background_rounded"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title"
                />

            <com.google.android.material.textview.MaterialTextView
                style="@style/CountdownWidgetIndicator"
                android:id="@+id/subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="16dp"
                android:gravity="start"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider"
                app:layout_constraintBottom_toTopOf="@id/endDate"
                tools:text="THANK YOU FOR WATCHING THE COUNTDOWN GO TO ZERO"
                tools:textColor="#ffffff"
                tools:visibility="gone"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/countdownContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="8dp"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider"
                app:layout_constraintBottom_toTopOf="@id/endDate"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                tools:visibility="visible"
                >

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/daysCard"
                    android:layout_width="58dp"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="6dp"
                        >

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/CountdownWidgetIndicator"
                            android:id="@+id/daysIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="30"
                            tools:textColor="#fff"
                            tools:textStyle="bold"
                            />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/CountdownWidgetIndicator"
                            android:id="@+id/days"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Days"
                            tools:textColor="#fff"
                            tools:textStyle="bold"
                            />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textview.MaterialTextView
                    style="@style/CountdownWidgetIndicator"
                    android:id="@+id/colon1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text=":"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/daysCard"
                    app:layout_constraintEnd_toStartOf="@id/hoursCard"
                    tools:textColor="#fff"
                    tools:textStyle="bold"
                    />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/hoursCard"
                    android:layout_width="58dp"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toEndOf="@id/colon1"
                    app:layout_constraintEnd_toStartOf="@id/colon2"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="6dp"
                        >

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/CountdownWidgetIndicator"
                            android:id="@+id/hoursIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="24"
                            tools:textColor="#fff"
                            tools:textStyle="bold"
                            />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/CountdownWidgetIndicator"
                            android:id="@+id/hours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:textColor="#fff"
                            tools:textStyle="bold"
                            tools:text="Hours"
                            />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textview.MaterialTextView
                    style="@style/CountdownWidgetIndicator"
                    android:id="@+id/colon2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text=":"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/hoursCard"
                    app:layout_constraintEnd_toStartOf="@id/minutesCard"
                    tools:textColor="#fff"
                    tools:textStyle="bold"
                    />


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/minutesCard"
                    android:layout_width="58dp"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toEndOf="@id/colon2"
                    app:layout_constraintEnd_toStartOf="@id/colon3"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="6dp"
                        >

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/CountdownWidgetIndicator"
                            android:id="@+id/minutesIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="06"
                            tools:textColor="#fff"
                            tools:textStyle="bold"
                            />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/CountdownWidgetIndicator"
                            android:id="@+id/minutes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:textColor="#fff"
                            tools:textStyle="bold"
                            tools:text="Min."
                            />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textview.MaterialTextView
                    style="@style/CountdownWidgetIndicator"
                    android:id="@+id/colon3"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text=":"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/minutesCard"
                    app:layout_constraintEnd_toStartOf="@id/secondsCard"
                    tools:textColor="#fff"
                    tools:textStyle="bold"
                    />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/secondsCard"
                    android:layout_width="58dp"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="6dp"
                        >

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/CountdownWidgetIndicator"
                            android:id="@+id/secondsIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="10"
                            tools:textColor="#fff"
                            tools:textStyle="bold"
                            />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/CountdownWidgetIndicator"
                            android:id="@+id/seconds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:textColor="#fff"
                            tools:textStyle="bold"
                            tools:text="Sec."
                            />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.textview.MaterialTextView
                style="@style/CountdownWidgetIndicator"
                android:id="@+id/endDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="ENDS ON : MAR 19, 2:00 PM"
                tools:textColor="#fff"
                tools:visibility="visible"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</merge>
