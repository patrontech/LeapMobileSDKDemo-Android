<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/titleCounterWidgetContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:minHeight="64dp"
        >

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/titleCounterWidgetIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/horizontal_margin"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/titleCounterWidgetTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/down_arrow_icon"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/titleCounterWidgetTitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="@id/titleCounterWidgetIcon"
            app:layout_constraintEnd_toStartOf="@+id/titleCounterWidgetNumber"
            app:layout_constraintStart_toEndOf="@id/titleCounterWidgetIcon"
            app:layout_constraintTop_toTopOf="@id/titleCounterWidgetIcon"
            tools:text="Hello, I am a TitleCounterWidget, I can be very long"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/titleCounterWidgetNumber"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="16dp"
            android:lineSpacingExtra="0dp"
            android:gravity="center"
            android:maxLines="1"
            android:background="@drawable/title_counter_widget_number_background"
            app:layout_constraintBottom_toBottomOf="@+id/titleCounterWidgetIcon"
            app:layout_constraintEnd_toStartOf="@+id/titleCounterWidgetRedirect"
            app:layout_constraintStart_toEndOf="@+id/titleCounterWidgetTitle"
            app:layout_constraintTop_toTopOf="@+id/titleCounterWidgetIcon"
            tools:src="@drawable/radiobutton_checked"
            tools:text="13"
            tools:textColor="#ffffff"
            tools:textSize="18sp"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/titleCounterWidgetRedirect"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/horizontal_margin"
            android:src="@drawable/ic_skip"
            app:layout_constraintBottom_toBottomOf="@+id/titleCounterWidgetIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/titleCounterWidgetIcon"
            tools:tint="@color/cardview_dark_background"
            />

        <View
            android:id="@+id/titleCounterWidgetSeparator"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            tools:background="@android:color/darker_gray"
            app:layout_constraintBottom_toBottomOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>

