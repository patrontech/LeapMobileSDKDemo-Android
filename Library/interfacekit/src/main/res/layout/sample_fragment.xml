<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    >

    <com.greencopper.interfacekit.ui.views.navigationcontrols.KibaToolbar
        android:id="@+id/sample_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="64dp"
            >

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/sample_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/sample_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_largeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font largeTitle"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_titleXL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font titleXL"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_titleL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font titleL"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_titleM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font titleM"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_titleS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font titleS"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_titleXS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font titleXS"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_headlineL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font headlineL"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_headlineM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font headlineM"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_headlineS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font headlineS"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_bodyXL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font bodyXL"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_bodyL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font bodyL"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_bodyM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font bodyM"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_bodyS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font bodyS"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_bodyXS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font bodyXS"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_captionL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font captionL"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_captionS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font captionS"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_footnoteM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font footnoteM"
                android:textColor="@android:color/black"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_footnoteS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a font footnoteS"
                android:textColor="@android:color/black"
                />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
