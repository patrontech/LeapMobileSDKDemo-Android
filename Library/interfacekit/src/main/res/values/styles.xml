<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.TextStyle.LargeTitle" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">34sp</item>
    </style>

    <style name="TextAppearance.TextStyle.TitleXL" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.TextStyle.TitleL" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.TextStyle.TitleM" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.TextStyle.TitleS" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.TextStyle.TitleXS" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.TextStyle.HeadlineL" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.TextStyle.HeadlineM" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.TextStyle.HeadlineS" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.TextStyle.BodyXL" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.TextStyle.BodyL" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.TextStyle.BodyM" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.TextStyle.BodyS" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.TextStyle.BodyXS" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.TextStyle.CaptionL" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.TextStyle.CaptionS" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.TextStyle.FootnoteM" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">10sp</item>
    </style>

    <style name="TextAppearance.TextStyle.FootnoteS" parent="@android:style/TextAppearance.Theme">
        <item name="android:textSize">10sp</item>
    </style>

    <style name="CustomBottomSheetRounded" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/BottomSheetRoundedStyle</item>
    </style>

    <style name="BottomSheetRoundedStyle" parent="">
        <item name="cornerSizeTopRight">10dp</item>
        <item name="cornerSizeTopLeft">10dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="CustomBottomSheetDialog" parent="@style/ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetModalStyle</item>
    </style>

    <style name="BottomSheetModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="shapeAppearanceOverlay">@style/BottomSheetRoundedStyle</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>

    <style name="CountdownWidgetIndicator">
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
