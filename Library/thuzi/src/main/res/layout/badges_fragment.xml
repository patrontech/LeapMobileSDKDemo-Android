<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".badges.ui.BadgesFragment">

    <ImageView
        android:id="@+id/rvBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:src="@drawable/bottom_rounded_corners" />

    <androidx.core.widget.NestedScrollView
        android:accessibilityTraversalAfter="@id/navigate_close_button"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:clipChildren="false">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/badgesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="74dp"
                android:layout_marginTop="?attr/actionBarSize"
                android:paddingTop="8dp"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Badges"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/badgesDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/horizontal_margin"
                android:layout_marginTop="8dp"
                android:textAlignment="center"
                app:layout_constraintTop_toBottomOf="@id/badgesTitle" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/badgesCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/horizontal_margin"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/badgesDescription"
                tools:text="1000/1000" />

            <!-- Padding of recyclerView items is already 6dp. So total horizontal padding is 6 + 18-->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/badgesRv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginVertical="@dimen/badge_recycler_verticalMargin"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/badge_recycler_horizontalPadding"
                android:overScrollMode="never"
                android:clipToPadding="false"
                android:clipChildren="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/badgesCounter"
                app:spanCount="12"
                tools:listitem="@layout/badges_item" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progress_loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateOnly="true"
        android:layout_gravity="center"
        />
        
    <com.greencopper.interfacekit.ui.views.navigationcontrols.NavigateBackButton
        android:id="@+id/navigate_back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:accessibilityTraversalAfter="@id/progress_loader"
        android:visibility="gone"/>

    <com.greencopper.interfacekit.ui.views.navigationcontrols.NavigateCloseButton
        android:id="@+id/navigate_close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityTraversalAfter="@id/navigate_back_button"
        android:layout_gravity="end"
        android:visibility="gone"/>
</FrameLayout>
