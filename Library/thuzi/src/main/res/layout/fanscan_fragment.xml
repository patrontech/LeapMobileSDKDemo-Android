<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ViewSwitcher
        android:id="@+id/view_switcher_fanscan"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/camera_view_switcher"
            layout="@layout/fanscan_camera_sub_layout" />

        <include
            android:id="@+id/permission_overlay_view_switcher"
            layout="@layout/fanscan_permission_sub_layout" />

    </ViewSwitcher>

    <com.greencopper.interfacekit.ui.views.navigationcontrols.NavigateBackButton
        android:id="@+id/navigate_back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.greencopper.interfacekit.ui.views.navigationcontrols.NavigateCloseButton
        android:id="@+id/navigate_close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- android:singleLine="true" required because of the bug in the material 1.3.0
    TODO: [KIBO-4665] required to upgrade library to latest and app's theme to latest Material3
     -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/continue_scan_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:textAllCaps="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Continue to scan" />

    <include
        android:id="@+id/scan_success"
        layout="@layout/scan_success_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>

