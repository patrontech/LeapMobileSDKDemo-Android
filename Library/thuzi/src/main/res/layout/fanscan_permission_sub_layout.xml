<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/permission_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="16dp"
    >

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon_iv"
        android:layout_width="39dp"
        android:layout_height="37dp"
        android:layout_marginTop="175dp"
        android:src="@drawable/ic_union"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:src="@drawable/ic_union"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/feature_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="92dp"
        android:paddingHorizontal="32dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/icon_iv"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="test_title" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/major_description_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textStyle="bold"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/feature_title_tv"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="test description this is long text to test the description. Squirrels have fur." />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/minor_description_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/major_description_tv"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="test description this is long text to test the description. Squirrels have fur." />

    <com.greencopper.interfacekit.ui.views.LeapButton
        android:id="@+id/cta_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintTop_toBottomOf="@id/minor_description_tv"
        tools:text="Settings" />

</androidx.constraintlayout.widget.ConstraintLayout>
