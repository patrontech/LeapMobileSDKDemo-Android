<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/stage_iv"
        android:layout_width="15dp"
        android:layout_height="19dp"
        android:layout_marginVertical="3dp"
        android:src="@drawable/ic_stage" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/stage_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Main stage" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/stage_map_pin"
        android:layout_width="@dimen/tappable_icon_size"
        android:layout_height="@dimen/tappable_icon_size"
        android:padding="@dimen/tappable_icon_padding" />
</LinearLayout>
