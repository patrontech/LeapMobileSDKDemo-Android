<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/performerItemContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:paddingHorizontal="@dimen/horizontal_margin"
        android:paddingVertical="21dp"
        android:minHeight="92dp"
        >

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:shape="ring"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:importantForAccessibility="no"
            >

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/performerItemPicture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/avatars"
                />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/performerItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            app:layout_constraintBottom_toTopOf="@id/performerItemSubtitle"
            app:layout_constraintEnd_toStartOf="@id/performerItemFavoriteAddRemove"
            app:layout_constraintStart_toEndOf="@id/cardView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginStart="0dp"
            app:layout_goneMarginEnd="24dp"
            tools:text="Resistentias congregabo in tornacum! Cum lanista potus, omnes pulchritudinees locus bi-color, secundus historiaes."
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/performerItemSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/performerItemFavoriteAddRemove"
            app:layout_constraintStart_toEndOf="@id/cardView"
            app:layout_constraintTop_toBottomOf="@id/performerItemTitle"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginStart="0dp"
            app:layout_goneMarginEnd="24dp"
            tools:text="Cum lanista potus, omnes locus bi-color, secundus historiaes. Resistentias congregabo in tornacum!"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/performerItemFavoriteAddRemove"
            android:layout_width="@dimen/tappable_icon_size"
            android:layout_height="@dimen/tappable_icon_size"
            android:padding="@dimen/tappable_icon_padding"
            app:layout_constraintBottom_toBottomOf="@+id/performerItemSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/performerItemTitle"
            tools:src="@drawable/radiobutton_checked"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
