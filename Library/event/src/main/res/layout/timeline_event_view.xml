<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:minHeight="56dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:padding="8dp"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    >

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/timelineItemMyScheduleButton"
        android:layout_width="@dimen/tappable_icon_size"
        android:layout_height="@dimen/tappable_icon_size"
        android:padding="@dimen/tappable_icon_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_schedule_item_calendar"
        />


    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/timelineItemLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/timelineItemSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/timelineItemMyScheduleButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Hello you" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/timelineItemSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/timelineItemMyScheduleButton"
        app:layout_constraintTop_toBottomOf="@+id/timelineItemLabel"
        tools:text="14:30AM - 14:34PM" />

</androidx.constraintlayout.widget.ConstraintLayout>
