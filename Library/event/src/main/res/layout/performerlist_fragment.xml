<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <com.greencopper.interfacekit.ui.views.navigationcontrols.KibaToolbar
        android:id="@+id/performerListToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        />

    <View
        android:id="@+id/performerListFilteringBarBorderTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/performerListToolbar"
        />

    <com.greencopper.interfacekit.filtering.filteringbar.ui.FilteringBar
        android:id="@+id/performerListFilteringBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/performerListFilteringBarBorderTop"
        />

    <View
        android:id="@+id/performerListFilteringBarBorderBottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/performerListFilteringBar"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/performerListRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/performerListFilteringBarBorderBottom"
        />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/performerListEmptyView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:constraint_referenced_ids="performerListEmptyViewTitle, performerListEmptyViewSubtitle, performerListEmptyViewImage"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/performerListEmptyViewImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/performerListEmptyViewTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:paddingTop="38dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/performerListEmptyViewImage"
        tools:text="No Favorites"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/performerListEmptyViewSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="@+id/performerListEmptyViewTitle"
        app:layout_constraintStart_toStartOf="@+id/performerListEmptyViewTitle"
        app:layout_constraintTop_toBottomOf="@+id/performerListEmptyViewTitle"
        tools:text="Your favorites will show up here!"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
