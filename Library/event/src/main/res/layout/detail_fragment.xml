<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ui.activitydetail.ActivityDetailFragment"
    >

    <ProgressBar
        android:id="@+id/detailProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:accessibilityTraversalAfter="@id/navigate_close_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp"
            >

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/detailHeaderView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/backgrounds/scenic"
                />

            <Space
                android:id="@+id/detailHeaderGoneSpacing"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:visibility="gone"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/scheduleDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="24dp"
                android:paddingStart="@dimen/horizontal_margin"
                android:paddingBottom="16dp"
                >

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/detailTitleTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_marginEnd="@dimen/horizontal_margin"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/detailFavoriteAddRemove"
                    tools:text="Title Event"
                    />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/detailSubtitleTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/horizontal_margin"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/detailTitleTextView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="Subtitle Event"
                    />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/detailFavoriteAddRemove"
                    android:layout_width="@dimen/tappable_icon_size"
                    android:layout_height="@dimen/tappable_icon_size"
                    android:padding="@dimen/tappable_icon_padding"
                    android:layout_marginTop="-10dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/detailTitleTextView"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:src="@drawable/radiobutton_checked"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <include
                android:id="@+id/detailStageView"
                layout="@layout/schedule_item_stage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/horizontal_margin"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible"
                />

            <include
                android:id="@+id/detailScheduleItemView"
                layout="@layout/schedule_item_itemview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="12dp"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/detailScheduleItemsTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/horizontal_margin"
                android:layout_marginBottom="8dp"
                tools:text="Upcoming times"
                />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/detailScheduleRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:layoutDirection="locale"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:overScrollMode="never"
                tools:listitem="@layout/schedule_item_cardview"
                />

            <com.greencopper.interfacekit.tags.ui.TagDisplayView
                android:id="@+id/detailTagDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"/>

            <com.greencopper.interfacekit.widgets.ui.widgetcollection.integration.WidgetCollectionView
                android:id="@+id/detailWidgetCollectionView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/detailTagDisplay"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/detailDescriptionTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/horizontal_margin"
                android:paddingTop="@dimen/vertical_margin"
                android:paddingBottom="10dp"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/detailDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/horizontal_margin"
                    app:layout_constraintTop_toTopOf="parent"
                    />

                <View
                    android:id="@+id/detailShowMoreGradientView"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:layout_constraintBottom_toBottomOf="@id/detailDescriptionTextView"
                    app:layout_constraintStart_toStartOf="@id/detailDescriptionTextView"
                    />

                <androidx.constraintlayout.widget.Group
                    android:id="@+id/detailShowMoreGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="detailShowMoreIcon,detailShowMoreTextView"
                    />

                <ImageView
                    android:id="@+id/detailShowMoreIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/event__activity__detail__show_arrow_description"
                    app:layout_constraintEnd_toStartOf="@+id/detailShowMoreTextView"
                    app:layout_constraintTop_toBottomOf="@+id/detailDescriptionTextView"
                    tools:src="@drawable/ic_baseline_keyboard_arrow_down_24"
                    />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/detailShowMoreTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/detailDescriptionTextView"
                    tools:text="Show More"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.greencopper.interfacekit.ui.views.navigationcontrols.NavigateBackButton
        android:id="@+id/navigate_back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <com.greencopper.interfacekit.ui.views.navigationcontrols.NavigateCloseButton
        android:id="@+id/navigate_close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:accessibilityTraversalAfter="@id/navigate_back_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
