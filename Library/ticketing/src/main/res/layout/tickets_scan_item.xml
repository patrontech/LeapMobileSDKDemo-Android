<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ticket_item_parent_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:background="#BDBDBD">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/primary_info_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.75"
            android:backgroundTint="#FFFFFF"
            app:cardCornerRadius="10dp"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toStartOf="@id/secondary_info_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:background="@drawable/cornered_bordered_background">

            <LinearLayout
                android:id="@+id/primary_info_card_two_lines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:visibility="invisible"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/primary_info_card_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="3"
                    android:ellipsize="end"
                    tools:text="Wed Feb 24, 2021" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/primary_info_card_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#80000000"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="6:00pm - 10:00pm" />
            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/primary_info_card_title_one_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:layout_gravity="center_vertical"
                android:layout_margin="16dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Wed Feb 24, 2021" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/secondary_info_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="2dp"
            android:backgroundTint="#FFFFFF"
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="@id/primary_info_card"
            app:layout_constraintEnd_toEndOf="@id/qr_code_card"
            app:layout_constraintStart_toEndOf="@id/primary_info_card"
            app:layout_constraintTop_toTopOf="@id/primary_info_card"
            app:layout_constraintWidth_min="73dp"
            app:layout_constraintWidth_percent="0.25"
            tools:visibility="visible"
            tools:background="@drawable/cornered_bordered_background">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/secondary_info_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#000000"
                android:textSize="14sp"
                tools:text="TYPE" />
        </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/qr_code_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="#FFFFFF"
        app:cardCornerRadius="10dp"
        android:visibility="visible"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/primary_info_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeWidth="1dp"
        tools:background="@drawable/cornered_bordered_background">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/qr_code_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@drawable/qr_animation">

            <com.greencopper.interfacekit.ui.BarcodeView
                android:id="@+id/qr_code_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="4dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:barcodeType="qr_code"
                app:layout_constraintBottom_toTopOf="@id/code_number"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.8"
                tools:src="@tools:sample/avatars" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/code_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="0123456789" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
